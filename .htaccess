DirectoryIndex index.php
Options -Indexes

# Block direct access to sensitive files
<FilesMatch "(db_setup.*\.sql|gen_hash\.php|seed_admin\.php|\.gitignore|README\.md|CLEANUP_GUIDE\.md|INFINITYFREE_UPLOAD_GUIDE\.md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
</IfModule>
