- 
+ # Database Configuration
+ DB_HOST=localhost
+ DB_USER=root
+ DB_PASS=
+ DB_NAME=db
+ DB_PORT=3306
+ SINGLE_DB=false
+ 
+ # Application
+ APP_URL=http://localhost/Drifter
+ APP_ENV=local
+ DEBUG=true
+ 
+ # Email Configuration (SMTP)
+ MAIL_DRIVER=smtp
+ MAIL_HOST=smtp.gmail.com
+ MAIL_PORT=587
+ MAIL_USERNAME=your-email@gmail.com
+ MAIL_PASSWORD=your-app-password
+ MAIL_FROM=noreply@drifter.com
+ MAIL_FROM_NAME=Drifter
+ 
+ # Security
+ JWT_SECRET=drifter-secret-key-change-in-production
+ HASH_ALGORITHM=bcrypt
+ 
+ # Rate Limiting (per hour)
+ RATE_LIMIT_REQUESTS=100
+ RATE_LIMIT_WINDOW=3600
+ 
+ # Logging
+ LOG_LEVEL=info
+ LOG_FILE=logs/app.log
+